# Copy this file to .env for local builds. Nothing here is secret.
#
# VITE_SITE_URL: the published address of the site, used for link-preview tags (og:url, og:image)
# so WhatsApp, iMessage and others can show the preview picture. On Netlify this is set in
# Project configuration → Environment variables, so the deployed build already has it.
# Leave it empty locally; the build then writes a relative og:image.
# Example: VITE_SITE_URL=https://their-forever-era.netlify.app
VITE_SITE_URL=
